    {
      "id": "b-wwd-groups",
      "type": "expect",
      "title": "Peer Support Groups",
      "body": [
        "Set aside an hour to reset! During Peer Support Groups, there’s no wrong answer, and you can talk about whatever feels most present in your life."
      ],
      "items": [
        {
          "icon": "bulb",
          "text": "Academics & Stress: classes, grades, burnout, and balancing work with school."
        },
        {
          "icon": "chat",
          "text": "Relationships: friendships, roommates, family pressure."
        },
        {
          "icon": "question",
          "text": "Uncertainty: identity, uncertainty about the future, and housing."
        }
      ],
      "links": [
        {
          "label": "View the Schedule",
          "href": "/join/peer-support-groups/",
          "icon": "calendar"
        }
      ],
