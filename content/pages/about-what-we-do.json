    {
      "id": "b-wwd-craft",
      "type": "expect",
      "title": "Craft Nights",
      "flip": true,
      "body": [
        "Need a break from classes? Drop in to a Badger Supports Craft Night! We host creative events where you can relax, meet new people, and make something cool—like bracelets, vision boards, bedazzled crafts, shrinky dinks, & more!",
        "No experience needed, no sign-ups required—just show up, hang out, and unwind with fellow Badgers.",
        "Check the Craft Night Schedule for the next date, time and location."
      ],
      "links": [
        {
          "label": "View the Schedule",
          "href": "/join/craft-nights/",
          "icon": "calendar"
        }
      ],
      "photos": [
        "m-craft-visionboards",
        "m-people-bedazzle-crafting"
      ],
      "disclosure": "More About Craft Nights",
      "preview": [
        "Take a break from classes with a creative activity and time with fellow Badgers.",
        "Drop in on your own or with friends. No registration is needed, no crafting experience is needed, and our announced Craft Nights are free to attend."
      ]
