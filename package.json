{
  "name": "badgersupports-public-site",
  "private": true,
  "type": "module",
  "description": "www.badgersupports.org — the public Badger Supports website. Static pages built from versioned content, native forms, one intake API.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node ops/build.mjs",
    "dev": "node ops/dev-server.mjs",
    "check": "node ops/check.mjs",
    "test": "node --test --test-concurrency=1 \"test/*.test.mjs\"",
    "shots": "node ops/shots.mjs",
    "a11y": "node ops/a11y.mjs",
    "capture-live": "node ops/capture-live.mjs",
    "media:fetch": "node ops/media.mjs --fetch",
    "editable": "node ops/editable.mjs",
    "contract": "node ops/contract.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "acorn": "8.19.0",
    "axe-core": "4.14.0",
    "clean-css": "5.3.3",
    "playwright": "1.62.1",
    "sharp": "0.34.4",
    "terser": "5.51.2"
  },
  "dependencies": {
    "@netlify/blobs": "11.1.4",
    "@netlify/database": "2.0.1",
    "@netlify/functions": "6.0.2"
  }
}
